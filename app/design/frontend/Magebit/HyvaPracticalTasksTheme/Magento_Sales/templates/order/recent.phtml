<?php

use Magento\Sales\Helper\Reorder as ReorderHelper;
use Magento\Framework\Data\Helper\PostHelper as PostHelper;

$_orders = $block->getOrders();
$ordersData = [];

foreach ($_orders as $_order) {
    $ordersData[] = [
        'id' => $_order->getRealOrderId(),
        'date' => $block->formatDate($_order->getCreatedAt()),
        'timestamp' => strtotime($_order->getCreatedAt()),
        'customer' => $_order->getShippingAddress() ? $_order->getShippingAddress()->getName() : '',
        'total' => strip_tags($_order->formatPrice($_order->getGrandTotal())),
        'status' => $_order->getStatus(),
    ];
}

$jsonOrders = json_encode($ordersData);
?>

<div class="block block-dashboard-orders w-full border border-paleGray" x-data="initOrders()">
    <div class="block-title order p-8 text-xl">
        <strong>
            <?= $block->escapeHtml(__('Pēdējie pasūtījumi')) ?>
        </strong>
    </div>
    <div class="block-content">
        <div class="table-wrapper orders-recent">
            <table class="data table table-order-items recent w-full">
                <thead>
                    <tr class="h-12 px-4 bg-customBlue text-white text-xs">
                        <th scope="col" class="col id"><?= $block->escapeHtml(__('PASŪTĪJUMA NR.')) ?></th>
                        <th scope="col" class="col date cursor-pointer" @click="sortOrders()">
                            <?= $block->escapeHtml(__('DATUMS')) ?>
                            <span x-text="sortOrder === 'DESC' ? '↓' : '↑'"></span>
                        </th>
                        <th scope="col" class="col shipping"><?= $block->escapeHtml(__('PASŪTĪTĀJS')) ?></th>
                        <th scope="col" class="col total"><?= $block->escapeHtml(__('SUMMA')) ?></th>
                        <th scope="col" class="col status"><?= $block->escapeHtml(__('STATUSS')) ?></th>
                        <th scope="col" class="col actions"><?= $block->escapeHtml(__('VIEW/REORDER')) ?></th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="order in orders" :key="order.id">
                        <tr class="h-12 border-b border-paleGray text-center text-sm">
                            <td class="col id text-customRed" x-text="order.id"></td>
                            <td class="col date text-customDark" x-text="order.date"></td>
                            <td class="col shipping text-customDark" x-text="order.customer || '—'"></td>
                            <td class="col total text-customDark font-bold" x-html="order.total"></td>
                            <td class="col status text-customDark">
                                <span class="inline-block w-2.5 h-2.5 rounded-full mr-2"
                                    :class="{
                                        'bg-customRed': order.status === 'pending',
                                        'bg-statusYellow': order.status === 'processing',
                                        'bg-statusGreen': order.status === 'complete',
                                        'bg-gray-500': order.status === ''
                                    }">
                                </span>
                                <span x-text="{
                                        'pending': 'Neapmaksāts',
                                        'processing': 'Gaida',
                                        'complete': 'Samaksāts'
                                    }[order.status] || order.status">
                                </span>
                            </td>
                            <td data-th="<?= $block->escapeHtml(__('Actions')) ?>" class="col actions">
                                <a href="<?= $block->escapeUrl($block->getViewUrl($_order)) ?>" class="action view">
                                    <img src="<?= $block->getViewFileUrl('images/icons/Eye.svg') ?>" class="w-5 h-5 inline-block mr-2" alt="View">
                                </a>
                                <?php if ($this->helper(ReorderHelper::class)->canReorder($_order->getEntityId())) : ?>
                                    <a
                                        href="/checkout/cart/"
                                        data-post='<?= $this->helper(PostHelper::class)->getPostData($block->getReorderUrl($_order))?>'
                                        class="action order">
                                        <img src="<?= $block->getViewFileUrl('images/icons/Reorder.svg') ?>" class="w-5 h-5 inline-block mr-2" alt="Reorder">
                                    </a>
                                <?php endif ?>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function initOrders() {
        return {
            orders: JSON.parse('<?= $jsonOrders ?>'),
            sortOrder: 'DESC',

            sortOrders() {
                this.orders.sort((a, b) => {
                    return this.sortOrder === 'DESC'
                        ? b.timestamp - a.timestamp
                        : a.timestamp - b.timestamp;
                });

                this.sortOrder = this.sortOrder === 'DESC' ? 'ASC' : 'DESC';
            }
        };
    }
</script>
