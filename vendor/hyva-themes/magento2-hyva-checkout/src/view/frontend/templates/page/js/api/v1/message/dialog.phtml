                                    'aria-hidden' => 'true'
                                ]
                            ) ?>
                            <?= $heroiconsSolid->checkCircleHtml(
                                'text-green-600',
                                64,
                                64,
                                [
                                    'x-show' => 'message.type === "success"',
                                    'aria-hidden' => 'true'
                                ]
                            ) ?>
                            <?= $heroiconsSolid->exclamationCircleHtml(
                                'text-yellow-600',
                                64,
                                64,
                                [
                                    'x-show' => 'message.type === "warning"',
                                    'aria-hidden' => 'true'
                                ]
                            ) ?>
