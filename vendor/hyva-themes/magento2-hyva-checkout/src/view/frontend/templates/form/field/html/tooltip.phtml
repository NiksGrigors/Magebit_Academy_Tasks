declare(strict_types=1);

use Hyva\Checkout\Model\Form\EntityFieldInterface;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var EntityFieldInterface $field */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

$element = $block->getData('element');
?>
<?php if ($element): ?>
    <div
        x-data="{ tooltipVisible: false }"
        class="relative tooltip"
    >
        <button
            type="button"
            x-on:mouseenter.self="tooltipVisible = true"
            x-on:mouseleave.self="tooltipVisible = false"
            x-on:click="tooltipVisible = !tooltipVisible"
            x-on:click.outside="tooltipVisible = false"
            class="align-middle hover:cursor-pointer opacity-75 hover:opacity-100"
            aria-label="<?= $escaper->escapeHtmlAttr(__('More information')) ?>"
            aria-describedby="form-tooltip-<?= $escaper->escapeHtmlAttr($element->getId()) ?>"
        >
            <?= $heroicons->questionMarkCircleHtml('', 32, 32, ['aria-hidden' => 'true']) ?>
        </button>
        <div
            id="form-tooltip-<?= $escaper->escapeHtmlAttr($element->getId()) ?>"
            role="tooltip"
            class="absolute top-full right-0 w-80 mt-3 px-3 py-2 bg-gray-500 text-white shadow-lg rounded-md"
            x-show="tooltipVisible"
            x-cloak
        >
            <div class="absolute right-3 -top-3 h-3 w-3 bg-inherit rotate-45 transform origin-bottom-left"></div>
            <?= $escaper->escapeHtml(__($element->getTooltip())) ?>
        </div>
    </div>
<?php endif ?>
