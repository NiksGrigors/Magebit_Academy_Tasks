<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd"
>
    <group id="design"
           showInDefault="1"
           showInStore="1"
           showInWebsite="1"
           sortOrder="80"
           translate="label"
    >
        <label>Design</label>

        <group id="shipping_payment_methods"
               showInDefault="1"
               showInStore="1"
               showInWebsite="1"
               sortOrder="10"
               translate="label"
        >
            <label>Shipping- &amp; Payment Method</label>

            <field id="universal_icon_width"
                   translate="label comment"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1"
            >
                <label>Universal Icon Width</label>
                <comment>This value serves as a universal standard for all icons but can be overridden as needed. It is typically applicable when a particular icon maintains a consistent width and doesn't require individual adjustment.</comment>
            </field>

            <field id="universal_icon_height"
                   translate="label comment"
                   type="text"
                   sortOrder="20"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1"
            >
                <label>Universal Icon Height</label>
                <comment>This value serves as a universal standard for all icons but can be overridden as needed. It is typically applicable when a particular icon maintains a consistent height and doesn't require individual adjustment.</comment>
                <validate>required-entry validate-digits validate-zero-or-greater </validate>
            </field>
        </group>
    </group>
</include>
