<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd"
>
    <group id="shipping_billing_form"
           showInDefault="1"
           showInStore="1"
           showInWebsite="1"
           sortOrder="30"
           translate="label"
    >
        <label>Shipping- &amp; Billing Forms</label>

        <field id="autosave_timeout"
               showInDefault="1"
               showInStore="1"
               showInWebsite="1"
               sortOrder="10"
               translate="label"
               type="text"
        >
            <label>Autosave Timeout</label>
            <comment>The time in milliseconds the customer must wait before the form is automatically saved. The timer resets with each new form interaction. (default: 3000).</comment>
            <validate>validate-number required-entry</validate>
        </field>
    </group>
</include>
